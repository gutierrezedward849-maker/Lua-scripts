local function toggleVisual(button, pill, knob, enabled)
	local targetPill
	local targetKnob

	if enabled then
		targetPill = Color3.fromRGB(55, 125, 80)
		targetKnob = Color3.fromRGB(235, 255, 240)
	else
		targetPill = Color3.fromRGB(45, 45, 53)
		targetKnob = Color3.fromRGB(150, 150, 160)
	end

	TweenService:Create(
		pill,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{BackgroundColor3 = targetPill}
	):Play()

	TweenService:Create(
		knob,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Position = enabled
				and UDim2.new(1, -21, 0.5, -9)
				or UDim2.new(0, 3, 0.5, -9),
			BackgroundColor3 = targetKnob
		}
	):Play()

	TweenService:Create(
		button,
		TweenInfo.new(0.18),
		{
			BackgroundColor3 = enabled
				and Color3.fromRGB(30, 38, 33)
				or Color3.fromRGB(27, 27, 34)
		}
	):Play()
end

