local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local bladeRunning = false
local orbRunning = false
local animationToggle = false

local function getCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function getRoot()
	local character = getCharacter()
	return character:FindFirstChild("HumanoidRootPart")
end

local function getTool()
	local character = player.Character

	if not character then
		return nil
	end

	for _, object in ipairs(character:GetChildren()) do
		if object:IsA("Tool") then
			return object
		end
	end

	return nil
end

local function playSwing()
	local character = getCharacter()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local tool = getTool()

	if not humanoid or not tool then
		return
	end

	local animation

	if animationToggle == false then
		animation = tool:FindFirstChild("Animation")
		animationToggle = true
	else
		animation = tool:FindFirstChild("Animation2")
		animationToggle = false
	end

	if animation and animation:IsA("Animation") then
		local track = humanoid:LoadAnimation(animation)
		track:Play()
	end
end

local function getRemotes()
	local tool = getTool()

	if not tool then
		return nil, nil
	end

	local bladeRemote
	local nothingRemote

	local bladePowerGiver = workspace:FindFirstChild("BladePowerGiver")

	if bladePowerGiver then
		bladeRemote = bladePowerGiver:FindFirstChild("RemoteEvent")
	end

	local handle = tool:FindFirstChild("Handle")

	if handle then
		local nothing = handle:FindFirstChild("nothing")

		if nothing then
			nothingRemote = nothing:FindFirstChild("RemoteEvent")
		end
	end

	return bladeRemote, nothingRemote
end

local function fireBlade()
	local bladeRemote, nothingRemote = getRemotes()

	if bladeRemote then
		bladeRemote:FireServer()
	end

	if nothingRemote then
		nothingRemote:FireServer()
	end

	playSwing()
end

local function bringOrbs()
	local root = getRoot()

	if not root then
		return
	end

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart") then
			if string.find(string.lower(object.Name), "orb", 1, true) then
				object.CFrame = root.CFrame
			end
		end
	end
end

